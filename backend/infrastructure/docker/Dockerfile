
# One Dockerfile for every deployable:  docker build -f infrastructure/docker/Dockerfile --build-arg APP=api -t oms-api .
#   APP = api | worker | scheduler | webhook-worker
# Targets: runtime (default, tiny prod image) | migrate (runs db:migrate + db:seed with the full workspace)

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

# ---- build: install the workspace once, bundle the app -----------------------
FROM base AS build
ARG APP=api
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
# Fail early with a readable message (and the real bin list in the log) if the bundler did not get installed.
RUN test -x apps/${APP}/node_modules/.bin/tsup || (echo "tsup is missing for @oms/${APP}: devDependencies were not installed" && ls -la apps/${APP}/node_modules/.bin node_modules/.bin 2>&1 | head -40 && exit 1)
RUN pnpm --filter @oms/${APP} build

# ---- migrate: owner-role schema migration + reference data seed --------------
FROM build AS migrate
CMD ["sh", "-c", "pnpm --filter @oms/database db:migrate && pnpm --filter @oms/database db:seed"]

# ---- runtime: only the bundle + exact production dependencies ----------------
FROM node:22-alpine AS runtime
ARG APP=api
ENV NODE_ENV=production
WORKDIR /app
# dist/package.json is generated by the build and pins EXACT versions of third-party deps.
COPY --from=build /repo/apps/${APP}/dist/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /repo/apps/${APP}/dist ./dist
USER node
EXPOSE 3000 3100
# Liveness only (no dependency checks): readiness is probed by the orchestrator on /health/ready.
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT:-3000}/health/live >/dev/null 2>&1 || wget -qO- http://127.0.0.1:${WORKER_HEALTH_PORT:-3100}/health/live >/dev/null 2>&1 || exit 1
CMD ["node", "--enable-source-maps", "dist/main.js"]
